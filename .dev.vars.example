# Copy to .dev.vars for `wrangler dev`. In production set these with:
#   npx wrangler secret put <NAME>

# From @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Any random string; must match what scripts/set-webhook.mjs sends
TELEGRAM_WEBHOOK_SECRET=change-me

# Your Telegram chat id (from @userinfobot) — the only chat allowed to run
# /usage. Unset means the command is disabled for everyone.
# In production: npx wrangler secret put ADMIN_CHAT_ID
ADMIN_CHAT_ID=

# For /usage. Token needs Account Analytics: Read and nothing else.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Only needed if you flip STT_PROVIDER in wrangler.jsonc away from "workers-ai".
# Set whichever one matches the provider you chose.
# STT_PROVIDER=groq     -> https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# STT_PROVIDER=mistral  -> https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=...

# Lets the bot caption a video from a social link instead of an upload.
# Ask the download-media-bot admin for the key (it is write-only in Wrangler).
# In production: npx wrangler secret put DOWNLOAD_API_KEY
# Unset means links are politely refused; uploads keep working.
DOWNLOAD_API_KEY=
