{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "video-caption",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "video-caption-media"
		},
		{
			"bucket_name": "video-caption-media",
			"binding": "video_caption_media",
			"remote": true
		}
	],
	// Per-chat caption settings from the bot's /settings menu.
	// Create with: npx wrangler kv namespace create CAPTION_SETTINGS
	"kv_namespaces": [
		
		{
			"binding": "CAPTION_SETTINGS",
			"id": "19ef1a58c9cc47e9a173c4c37fca8095",
			"remote": true
		}
	],
	// Dockerfile lives at the project root so the build context can see ./public.
	"containers": [
		{
			"class_name": "FfmpegContainer",
			"image": "./Dockerfile",
			"instance_type": "standard-2",
			"max_instances": 5
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "FFMPEG",
				"class_name": "FfmpegContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"FfmpegContainer"
			]
		}
	],
	"workflows": [
		{
			"name": "caption-workflow",
			"binding": "CAPTION_WORKFLOW",
			"class_name": "CaptionWorkflow"
		}
	],
	"vars": {
		// The font's INTERNAL family name, not its filename — libass silently
		// falls back to a Latin font (= tofu for Arabic) on a mismatch.
		// Bundled: "Al Jazeera" (Light/Regular/Bold) and "thmanyah serif display"
		// (Regular only). Verify with GET /debug/fonts?secret=…
		"SUBTITLE_FONT": "Al Jazeera",
		// Al Jazeera ships a real Bold; thmanyah does not — set false for it,
		// synthetic bold smears Arabic letterforms.
		"SUBTITLE_FONT_BOLD": "true",
		// clean | hormozi | cinematic | youtube | naskh
		"CAPTION_PRESET": "clean",
		"CAPTION_SIZE": "medium",
		"CAPTION_POSITION": "bottom",
		"SOURCE_LANG": "en",
		"TARGET_LANG": "ar",
		// PREFERRED transcription provider, not the only one. Whichever is named
		// here is tried first, then the remaining ones in the order
		// groq → mistral → workers-ai, so an outage or a spent quota rolls over
		// instead of failing the job. A provider whose key is missing is skipped;
		// workers-ai needs no key and is therefore always the last resort.
		// groq (GROQ_API_KEY) | mistral (MISTRAL_API_KEY) | workers-ai (no key)
		"STT_PROVIDER": "groq",
		// Workers AI speech model — used only on the workers-ai leg of that
		// chain. Groq and Mistral name their own models in src/pipeline/ai.ts.
		"WHISPER_MODEL": "@cf/openai/whisper-large-v3-turbo",
		// Default translation model, and the starting point for the 🧠 Translator
		// row in /settings and on each video's ✏️ Edit card. An instruct LLM
		// translates a sentence far better than a dedicated MT model does; m2m100
		// is kept as the cheap, literal option. Use one of the models the menu
		// offers or it falls back to Llama 3.3 70B:
		//   @cf/meta/llama-3.3-70b-instruct-fp8-fast  most accurate
		//   @cf/meta/llama-4-scout-17b-16e-instruct   faster
		//   @cf/meta/m2m100-1.2b                      literal, cheapest
		"TRANSLATION_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"CHUNK_SECONDS": "240",
		"MAX_VIDEO_SECONDS": "900",
		// Caption pacing. Whisper returns long paragraphs; this splits them.
		// ~42 chars is the broadcast norm — lower for punchier one-line cues.
		// Words are never broken, so a single longer word overflows intact.
		// This is only the starting point: it is the 📏 Line length row in
		// /settings and on each video's ✏️ Edit card. Use one of the values the
		// menu offers (28, 36, 42, 52, 64) or the menu falls back to 42.
		"MAX_CAPTION_CHARS": "42",
		// Social links are resolved by download-media-bot, which returns direct
		// media links rather than bytes. Override only to point at another
		// deployment; the API key itself is a secret (DOWNLOAD_API_KEY).
		"DOWNLOAD_API_BASE": "https://dl.engdawood.com",
		// Ceiling on a video pulled from a link. Telegram refuses bot uploads
		// over 50 MB and burning captions re-encodes rather than shrinks, so
		// leave headroom below that.
		"MAX_SOURCE_MB": "45",
		// For /usage. Not a secret — it appears in every dashboard URL. Only
		// the paired CLOUDFLARE_API_TOKEN is a secret (Account Analytics: Read).
		"CLOUDFLARE_ACCOUNT_ID": "c53938b50ea00b247dcd72dd2e9eada3"
		// ADMIN_CHAT_ID is deliberately NOT a var — it is set as a secret so it
		// stays out of git. Declaring it here too would collide with the secret.
	}
}